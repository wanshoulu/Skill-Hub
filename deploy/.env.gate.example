# gate-service 部署环境变量（复制到服务器 ~/skillhub/.env，不进 git）
# 网络名用 `docker network ls` 在服务器上确认（skillhub 主 compose 项目名 _default）。
SKILLHUB_NETWORK=skillhub_default

# 门禁鉴权 Bearer Token（openssl rand -hex 24 生成）
GATE_TOKEN=

# LLM 通路 A：maas 镜像站直连（模型探测结果见 /v1/healthz）
LLM_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen3.7-flash
